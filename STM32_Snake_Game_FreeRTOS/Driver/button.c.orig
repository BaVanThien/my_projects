#include "button.h"

void Button_Init(void)
{
    GPIO_Config(BTN_UP_PORT,    BTN_UP_PIN,    GPIO_MODE_INPUT_PU);
    GPIO_Config(BTN_DOWN_PORT,  BTN_DOWN_PIN,  GPIO_MODE_INPUT_PU);
    GPIO_Config(BTN_LEFT_PORT,  BTN_LEFT_PIN,  GPIO_MODE_INPUT_PU);
    GPIO_Config(BTN_RIGHT_PORT, BTN_RIGHT_PIN, GPIO_MODE_INPUT_PU);
}

int Button_Up_Pressed(void)    { return GPIO_Read_Pin(BTN_UP_PORT,    BTN_UP_PIN)    == 0; }
int Button_Down_Pressed(void)  { return GPIO_Read_Pin(BTN_DOWN_PORT,  BTN_DOWN_PIN)  == 0; }
int Button_Left_Pressed(void)  { return GPIO_Read_Pin(BTN_LEFT_PORT,  BTN_LEFT_PIN)  == 0; }
int Button_Right_Pressed(void) { return GPIO_Read_Pin(BTN_RIGHT_PORT, BTN_RIGHT_PIN) == 0; }
 