#include "task_input.h"
#include "button.h"
#include "main.h"
#include "game_logic.h"
#include "button.h"

#define DEBOUNCE_COUNT 2


void vTaskInput(void *pvParameters)
{
     uint8_t cnt_up    = 0, cnt_down  = 0;
    uint8_t cnt_left  = 0, cnt_right = 0;
    uint8_t sent_up   = 0, sent_down  = 0;
    uint8_t sent_left = 0, sent_right = 0;
    
    (void)pvParameters;
    while (1) {
        if (Button_Up_Pressed()) {
            if (!sent_up && ++cnt_up >= DEBOUNCE_COUNT) {
                xEventGroupSetBits(xDirectionEvent, DIR_EVENT_UP);
                sent_up = 1;
            }
        } else { cnt_up = 0; sent_up = 0; }

        if (Button_Down_Pressed()) {
            if (!sent_down && ++cnt_down >= DEBOUNCE_COUNT) {
                xEventGroupSetBits(xDirectionEvent, DIR_EVENT_DOWN);
                sent_down = 1;
            }
        } else { cnt_down = 0; sent_down = 0; }

        if (Button_Left_Pressed()) {
            if (!sent_left && ++cnt_left >= DEBOUNCE_COUNT) {
                xEventGroupSetBits(xDirectionEvent, DIR_EVENT_LEFT);
                sent_left = 1;
            }
        } else { cnt_left = 0; sent_left = 0; }

        if (Button_Right_Pressed()) {
            if (!sent_right && ++cnt_right >= DEBOUNCE_COUNT) {
                xEventGroupSetBits(xDirectionEvent, DIR_EVENT_RIGHT);
                sent_right = 1;
            }
        } else { cnt_right = 0; sent_right = 0; }

        vTaskDelay(pdMS_TO_TICKS(5));
    }
}
