#define BTN_UP_PORT    GPIOA
#define BTN_UP_PIN     GPIO_PIN_4

#define BTN_DOWN_PORT  GPIOA
#define BTN_DOWN_PIN   GPIO_PIN_1

#define BTN_LEFT_PORT  GPIOA
